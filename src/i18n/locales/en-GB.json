  "home": {
    "title": "Guilherme Gonçalves",
    "subtitle": "Software Engineer · Mathematics Tutor",
    "presentation": {
      "title": "Introduction",
      "content": "I am a software engineer with 17 years of experience, starting in an R&D setting building embedded systems for data acquisition equipment and precision electromechanical devices, later migrating to web development. I studied Electrical Engineering for three years at UFSC (Federal University of Santa Catarina, Brazil) and switched to Mathematics in 2016 at the same university, obtaining a bachelor's degree in 2019. I currently work as a back-end engineer designing scalable cloud-based software, with an emphasis on Python, TypeScript, Go and Java, with a particular interest in event-driven architectures, workflow engine designs and complexity analysis. I also work part-time as a private Maths teacher, mostly for undergraduate and secondary-school students."
    },
    "specialties": {
      "title": "Specialties",
      "items": [
        "Event-driven architectures",
        "Workflow engine design",
        "Complexity analysis (Big-O)",
        "Scalable back-end development (Python, TypeScript, Java, Go)",
        "Embedded systems and data acquisition",
        "Mathematics teaching (Calculus, Analysis, Algebra)"
      ]
    },
    "workRegime": {
      "title": "Allocation / Working arrangements",
      "content": "Available for service contracts (PJ) on a remote or hybrid basis. Experience with full-time and part-time remote work. Sole trader company: Guilherme L. Gonçalves Desenvolvimento de Sistemas Ltda. (CNPJ/ME: 44.867.072/0001-06)."
    },
    "hiring": {
      "title": "Engagement",
      "content": "Preference for service contracts (PJ). Open to discussing employment contracts in exceptional cases. Available for short-, medium- and long-term projects. Please get in touch via the contact form or the channels listed in the footer."
    }
  },
